# Example environment variables for profile-endpoint
# Copy this file to `.env` and edit the values as needed.

# The email that will appear in the /me response
EMAIL=you@example.com

# The name that will appear in the /me response
NAME=Your Name

# A short description of your tech stack or tags
STACK=JavaScript,Node,Express

# Port the server will listen on (defaults to 5000 if not set)
# Use an integer value, e.g. 5000
PORT=5000

# Notes:
# - This repository already ignores `.env` in .gitignore, so do NOT commit
#   any real secrets to version control.
# - You can export these vars in your shell instead of using a .env file.